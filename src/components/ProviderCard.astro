---
import Promo from './Promo.astro';
import { fmtGB, fmtPrice, planPrice, planTraffic, unlockText, type Provider } from '../data/providers';

interface Props { provider: Provider; rank: number }
const { provider: p, rank } = Astro.props;
---
<article class="box pcard" id={p.slug}>
  <header class="pcard-head">
    <span class={`rank ${rank === 1 ? 'rank-1' : ''}`}>{rank}</span>
    {p.logo && <img src={p.logo} alt={`${p.name} logo`} width="40" height="40" loading="lazy" decoding="async" />}
    <h3><a href={p.url}>{p.name}</a></h3>
    <span class="pcard-price"><span class="price">{p.entry ? fmtPrice(p.entry.price) : p.price}</span><small>{p.entry ? '/月起' : p.priceUnit}</small></span>
  </header>
  <p class="pcard-verdict"><strong>推荐理由：</strong>{p.verdict}。</p>
  <dl class="pcard-facts">
    <div><dt>线路</dt><dd>{p.lineLabel} 专线</dd></div>
    <div><dt>每月流量</dt><dd>{fmtGB(p.minTraffic)}–{fmtGB(p.maxTraffic)}</dd></div>
    <div><dt>年付最低</dt><dd>{p.minYearly ? `${planPrice(p.minYearly)}（${planTraffic(p.minYearly)}）` : '无'}</dd></div>
    <div><dt>不限时包</dt><dd>{p.oneTime.length ? `${p.oneTime.length} 款，${fmtPrice(p.oneTime[0].price)} 起` : '无'}</dd></div>
    <div><dt>解锁</dt><dd>{unlockText(p)}</dd></div>
    <div><dt>设备数</dt><dd>{p.deviceInfo && !/未/.test(p.deviceInfo) ? p.deviceInfo : '官网未写明'}</dd></div>
  </dl>
  <ul class="list pcard-feat">
    {p.features.slice(0, 4).map((f) => <li>{f}</li>)}
  </ul>
  <p class="muted" style="margin:0 0 .75rem">适合：{p.bestFor}</p>
  <div class="actions">
    <a class="btn" href={p.affiliateUrl} target="_blank" rel="nofollow sponsored noopener">前往 {p.name} 官网</a>
    <a class="btn btn-outline" href={p.url}>看 {p.name} 测评</a>
    <Promo code={p.promo} />
  </div>
</article>

<style>
  .pcard { margin-bottom: 1rem; }
  .pcard-head { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .pcard-head img { height: 40px; width: auto; max-width: 110px; object-fit: contain; }
  .pcard-head h3 { margin: 0; font-size: 1.25rem; flex: 1; }
  .pcard-head h3 a { color: var(--text-color); }
  .pcard-price .price { font-size: 1.4rem; }
  .pcard-price small { color: var(--text-muted); margin-left: 2px; }
  .pcard-verdict { margin-bottom: 0.75rem; }
  .pcard-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.6rem 1rem; background: var(--bg-alt); border-radius: 10px; padding: 0.8rem 1rem; margin-bottom: 0.75rem; }
  .pcard-facts dt { font-size: 0.8rem; color: var(--text-muted); }
  .pcard-facts dd { font-weight: 600; font-size: 0.93rem; }
  .pcard-feat { margin-bottom: 0.5rem; color: #334155; }
</style>
