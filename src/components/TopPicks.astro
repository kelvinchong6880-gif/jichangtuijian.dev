---
// 编辑推荐榜：顺序 = 综合排名（SOGO云第一），下方页面表格再按价格/单价客观排序。
import Promo from './Promo.astro';
import BrandName from './BrandName.astro';
import { perGB, fmtGB, fmtPrice, planPrice, type Provider } from '../data/providers';

interface Props { list: Provider[]; mode: 'cheap' | 'value'; title: string; firstReason: string }
const { list, mode, title, firstReason } = Astro.props;
const [first, ...rest] = list;
const priceText = (p: Provider) =>
  mode === 'cheap'
    ? `月付 ${p.entry ? `${fmtPrice(p.entry.price)} / ${fmtGB(p.entry.traffic)}` : '—'}${p.minYearly ? `，年付 ${fmtPrice(p.minYearly.price)} 起` : ''}`
    : p.bestValue ? `${p.bestValue.name} ${planPrice(p.bestValue)} ${fmtGB(p.bestValue.traffic)}，约 ¥${perGB(p.bestValue)!.toFixed(3)}/GB` : '—';
---
<section class="section" id="picks">
  <h2>{title}</h2>
  <div class="callout">
    <p style="margin:0 0 .4rem"><span class="rank rank-1" style="margin-right:.4rem">1</span><strong>首选：<a href={first.url}>{first.name}</a></strong> · {first.lineLabel} 专线</p>
    <p class="num" style="margin:0 0 .4rem"><span class="price">{priceText(first)}</span></p>
    <p style="margin:0 0 .8rem">{firstReason}</p>
    <div class="actions">
      <a class="btn" href={first.affiliateUrl} target="_blank" rel="nofollow sponsored noopener">前往 {first.name} 官网</a>
      <Promo code={first.promo} />
      <a href={first.url}>看测评</a>
    </div>
  </div>
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr><th scope="col">#</th><th scope="col">机场</th><th scope="col">{mode === 'cheap' ? '价格' : '最划算套餐'}</th><th scope="col">推荐理由</th><th scope="col">优惠码</th></tr></thead>
      <tbody>
        {rest.map((p, i) => (
          <tr><td><span class="rank">{i + 2}</span></td><td><BrandName p={p} /></td><td class="num">{priceText(p)}</td><td style="min-width:220px">{p.verdict}</td><td><code>{p.promo ?? '—'}</code></td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="muted">推荐榜综合价格、线路、稳定性和解锁情况排序；下面各表按{mode === 'cheap' ? '价格' : '每 GB 单价'}客观排序，方便对照。</p>
</section>
