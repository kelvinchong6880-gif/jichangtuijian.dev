---
import { SITE } from '../data/config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div style="display: flex; justify-content: center; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
      <img src="/images/brand/logo-mark.svg" alt="" width="24" height="24" style="height: 24px; width: auto;" />
      <span style="font-weight: bold; color: var(--text-color);">机场推荐</span>
    </div>
    <p style="margin-bottom: 0.5rem;"><a href="/links/" style="color: var(--text-muted); text-decoration: underline; font-size: 0.85rem;">友情链接与相关网站</a></p>
    <p>&copy; {year} 机场推荐. All rights reserved.</p>
    <p style="margin-top: 0.5rem; font-size: 0.75rem;">本站提供的信息仅供参考，请遵守您所在国家或地区的法律法规。</p>
  </div>
</footer>
