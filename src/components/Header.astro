---
import { NAV_LINKS } from '../data/config';
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="header">
  <div class="container header-inner">
    <a class="logo" href="/" aria-label="机场推荐首页">
      <img src="/images/brand/logo-horizontal.svg" alt="机场推荐" width="126" height="36" />
    </a>
    <nav aria-label="主导航">
      <ul class="nav-links">
        {NAV_LINKS.map((l) => (
          <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.text}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
