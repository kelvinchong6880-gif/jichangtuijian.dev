---
import ReviewPage from '../../components/ReviewPage.astro';
import { getProviders, type Provider } from '../../data/providers';

// sogocloud 由 sogocloud.astro 单独输出（同一模板），这里跳过避免路由冲突
export function getStaticPaths() {
  return getProviders()
    .filter((p) => p.slug !== 'sogocloud')
    .map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Provider };
---
<ReviewPage p={p} />
