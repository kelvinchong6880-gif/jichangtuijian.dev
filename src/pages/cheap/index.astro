---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclosure from '../../components/Disclosure.astro';
import TopPicks from '../../components/TopPicks.astro';
import BrandName from '../../components/BrandName.astro';
import { getProviders, getProviderBySlug, perGB, monthlyEq, cheapestFor, USAGE, fmtGB, fmtPrice, planPrice, UPDATED, UPDATED_LABEL, UPDATED_MONTH, UPDATED_TAG, type Plan, type Provider } from '../../data/providers';
import { faqSchema, itemListSchema, articleSchema } from '../../data/schema';

const providers = getProviders();
const n = providers.length;
const sogo = getProviderBySlug('sogocloud')!;
const flat = (f: (p: Provider) => Plan[]) => providers.flatMap((p) => f(p).map((plan) => ({ p, plan })));
const monthly = flat((p) => p.monthly);
const under30 = monthly.filter(({ plan }) => plan.price <= 30).sort((a, b) => a.plan.price - b.plan.price || b.plan.traffic! - a.plan.traffic!);
const yearly = flat((p) => p.yearly).sort((a, b) => a.plan.price - b.plan.price);
const oneTime = flat((p) => p.oneTime).sort((a, b) => a.plan.price - b.plan.price);
const lowest = under30[0];
const lowestYear = yearly[0];
// 按预算：折合月价不超过预算的周期套餐里，流量最多的 3 个
const periodic = flat((p) => p.priced.filter((x) => x.billing !== 'One-Time' && x.traffic));
const budgets = [10, 20, 30, 50].map((b) => ({
  b,
  rows: periodic
    .filter(({ plan }) => monthlyEq(plan)! <= b)
    .sort((x, y) => y.plan.traffic! - x.plan.traffic! || monthlyEq(x.plan)! - monthlyEq(y.plan)!)
    .filter(({ p }, i, arr) => arr.findIndex((x) => x.p === p) === i)
    .slice(0, 3),
}));
// 每家最便宜的三种买法
const brandCheapest = [...providers].sort((a, b) => (a.entry?.price ?? 1e9) - (b.entry?.price ?? 1e9));
// 按用途：满足用量的最便宜周期套餐 + 够用一个月的最低价不限时包（oneTime 已按价格排序）
const usageCheap = USAGE.map((u) => {
  const best = providers
    .map((p) => ({ p, plan: cheapestFor(p, u.need) }))
    .filter((x) => x.plan)
    .sort((a, b) => monthlyEq(a.plan!)! - monthlyEq(b.plan!)!)[0];
  const pack = oneTime.find(({ plan }) => (plan.traffic ?? 0) >= u.need);
  return { u, best, pack };
});

const title = `便宜机场推荐2026：月付¥${lowest.plan.price}起、年付¥${lowestYear.plan.price}起的专线机场（${UPDATED_TAG}）`;
const description = `2026便宜机场推荐（${UPDATED_MONTH}更新）：${n}家IPLC专线机场的最低价套餐，月付¥${lowest.plan.price}起、年付¥${lowestYear.plan.price}起、不限时包¥${oneTime[0].plan.price}起，分月付¥30以内、年付小包、不限时流量包三张表，附学生党推荐和优惠码。`;

const faq = [
  { q: '预算只有二三十块，新手买哪个？', a: `¥25 左右首推 ${sogo.name} 基础版（¥25/月 150GB，${sogo.lineLabel} 专线），够日常刷视频；只想花最少的钱，${lowest.p.name} ${fmtPrice(lowest.plan.price)}/月 ${fmtGB(lowest.plan.traffic)}。结算时记得填优惠码。` },
  { q: '网上说“几块钱一个月”的机场是真的吗？', a: `大多是把年付价格除以 12 算出来的。比如 ${lowestYear.p.name} ${fmtPrice(lowestYear.plan.price)}/年，折合约 ${fmtPrice(lowestYear.plan.price / 12)}/月，但要一次付一年。真正按月付，靠谱的专线机场基本在 ¥19 以上。` },
  { q: '学生没什么钱，有学生套餐吗？', a: `有。飞猫云的“学生版”¥84/年，每月 50GB；其他机场的年付小包也差不多：${yearly.slice(0, 3).map(({ p, plan }) => `${p.name} ${fmtPrice(plan.price)}/年`).join('、')}。查资料、用 ChatGPT 完全够。` },
  { q: '便宜机场会不会很卡、根本用不了？', a: `本页 ${n} 家都是专线机场，¥19–¥25 的入门套餐和贵的套餐走的是同一种线路，主要差别是流量多少，不是速度。真正容易卡的是不写线路、价格低得离谱的小机场。` },
  { q: '一个月只用几次，怎么最省？', a: `买“不过期”的流量包：一次付钱，流量用完为止，不会每月清零。最便宜的是 ${oneTime[0].p.name} ${fmtPrice(oneTime[0].plan.price)} ${fmtGB(oneTime[0].plan.traffic)}。` },
  { q: '有没有免费机场？为什么不推荐？', a: '网上有免费节点和“免费试用”，但免费节点通常限速、人多、经常失效，还可能记录你的访问数据。专线机场最便宜一年不到 ¥100，按月算只要几块钱，长期用比折腾免费节点省心得多。' },
  { q: '便宜机场能看 YouTube 和 Netflix 吗？', a: `能。本页大多数机场的入门套餐和贵的套餐用的是同一批节点，看 YouTube 1080P 没问题；看 Netflix 要选官网写明支持流媒体解锁的，比如 ${providers.filter((p) => p.streaming).slice(0, 3).map((p) => p.name).join("、")}。注意每月 40–60GB 的年付小包不适合天天看视频。` },
];
const schemas = [itemListSchema(`${UPDATED_MONTH}便宜机场推荐`, providers), faqSchema(faq), articleSchema(title, description, '/cheap/')];
---

<BaseLayout title={title} description={description} structuredData={schemas} ogType="article" breadcrumbs={[{ name: '便宜机场', path: '/cheap/' }]}>
  <div class="container page">
    <p class="eyebrow">更新于 <time datetime={UPDATED}>{UPDATED_LABEL}</time></p>
    <h1>便宜机场推荐 2026：月付 ¥{lowest.plan.price} 起的低价专线机场</h1>
    <p class="lead">预算有限也能用上专线机场。下面按 <strong>真实价格</strong> 排序（不拿年付折算冒充月付），分成月付 ¥30 以内、年付小包、不限时流量包三张表，{n} 家全是 IPLC / IEPL 专线。</p>
    <Disclosure />

    <TopPicks
      list={providers.slice(0, 6)}
      mode="cheap"
      title="便宜机场推荐 Top 6（综合排名）"
      intro="便宜不等于越低价越好。这份榜单在价格之外，还考虑了线路是否稳定、晚高峰卡不卡、能不能看 Netflix 和用 ChatGPT，挑出 6 家“便宜又能长期用”的机场。"
      firstReason="¥25/月就能用上 150GB IPLC/IEPL 双专线，年付小包 ¥98/年；晚高峰稳定、解锁 Netflix 和 ChatGPT，是“便宜又不卡”最均衡的选择。"
    />

    <section class="section" id="budget">
      <h2>按预算选便宜机场：每月 ¥10 / ¥20 / ¥30 / ¥50 能买到什么</h2>
      <p>先想好每个月最多愿意花多少钱，再看这个预算里谁给的流量最多。年付、季付已折成每月价格，每档列出流量最多的 3 个套餐（同一家只列一次）。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">每月预算</th><th scope="col">第 1 名</th><th scope="col">第 2 名</th><th scope="col">第 3 名</th></tr></thead>
          <tbody>
            {budgets.map(({ b, rows }) => (
              <tr>
                <td><strong>¥{b} 以内</strong></td>
                {[0, 1, 2].map((i) => {
                  const r = rows[i];
                  return <td class="num">{r ? <><a href={r.p.url}>{r.p.name}</a> {r.plan.name}<br /><span class="price">{fmtGB(r.plan.traffic)}/月</span> · {fmtPrice(monthlyEq(r.plan)!)}/月{r.plan.billing !== 'Monthly' && <span class="muted">（{planPrice(r.plan)}）</span>}</> : '—'}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" id="brands">
      <h2>{n} 家机场最便宜的套餐一览</h2>
      <p>每家机场都有月付、年付、不限时三种买法，最低价差别很大。下表把每家三种买法的最低价放在一起，按月付价格从低到高排列，方便一眼看出谁的门槛最低。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">机场</th><th scope="col">最低月付</th><th scope="col">最低年付</th><th scope="col">最低不限时包</th><th scope="col">优惠码</th></tr></thead>
          <tbody>
            {brandCheapest.map((p) => (
              <tr class={p.slug === 'sogocloud' ? 'hl' : ''}>
                <td><BrandName p={p} /></td>
                <td class="num">{p.entry ? <><span class="price">{planPrice(p.entry)}</span><br /><span class="muted">{fmtGB(p.entry.traffic)}/月</span></> : '—'}</td>
                <td class="num">{p.minYearly ? <>{planPrice(p.minYearly)}<br /><span class="muted">{fmtGB(p.minYearly.traffic)}/月 · 折合 {fmtPrice(monthlyEq(p.minYearly)!)}/月</span></> : '—'}</td>
                <td class="num">{p.oneTime.length ? <>{fmtPrice(p.oneTime[0].price)}<br /><span class="muted">{fmtGB(p.oneTime[0].traffic)} 不过期</span></> : '无'}</td>
                <td><code>{p.promo ?? '—'}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" id="usage">
      <h2>按用途选：每种用量最省钱的买法</h2>
      <p>同样的用量，按月买和买不限时包哪个更省？下表左边是满足用量的最便宜订阅套餐，右边是够用一个月的最便宜不限时包。每月都要用选订阅；隔几个月才用一次选不限时包。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">用途</th><th scope="col">每月需要</th><th scope="col">最便宜订阅</th><th scope="col">不限时包替代</th></tr></thead>
          <tbody>
            {usageCheap.map(({ u, best, pack }) => (
              <tr>
                <td><strong>{u.label}</strong><br /><span class="muted">{u.desc}</span></td>
                <td class="num">{u.need}GB+</td>
                <td>{best ? <><a href={best.p.url}>{best.p.name}</a> {best.plan!.name}<br /><span class="num price">{fmtPrice(monthlyEq(best.plan!)!)}/月</span> · {fmtGB(best.plan!.traffic)}</> : '—'}</td>
                <td>{pack ? <><a href={pack.p.url}>{pack.p.name}</a> {pack.plan.name}<br /><span class="num">{fmtPrice(pack.plan.price)} · {fmtGB(pack.plan.traffic)}</span> <span class="muted">（约够 {Math.floor(pack.plan.traffic! / u.need)} 个月）</span></> : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" id="monthly">
      <h2>月付 ¥30 以内的便宜机场</h2>
      <p>第一次买机场最推荐月付：不用一次掏一年的钱，用得不满意下个月换一家就行。下面是所有 ¥30 以内的月付套餐，按价格从低到高排列，“每 GB”越低越划算。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">机场</th><th scope="col">套餐</th><th scope="col">月付</th><th scope="col">每月流量</th><th scope="col">每 GB</th><th scope="col">优惠码</th><th scope="col"><span class="sr-only">操作</span></th></tr></thead>
          <tbody>
            {under30.map(({ p, plan }) => (
              <tr class={p.slug === 'sogocloud' ? 'hl' : ''}><td><BrandName p={p} /></td><td>{plan.name}</td><td class="num price">{fmtPrice(plan.price)}</td><td class="num">{fmtGB(plan.traffic)}</td><td class="num">¥{perGB(plan)!.toFixed(3)}</td><td><code>{p.promo ?? '—'}</code></td><td><a class="btn btn-sm" href={p.affiliateUrl} target="_blank" rel="nofollow sponsored noopener">官网</a></td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" id="yearly">
      <h2>年付便宜机场（学生党、轻度用户）</h2>
      <p>一年付一次，每月 40–150GB。查资料、用 ChatGPT、刷社交软件选小包就够。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">机场</th><th scope="col">套餐</th><th scope="col">年付</th><th scope="col">折合每月</th><th scope="col">每月流量</th></tr></thead>
          <tbody>
            {yearly.map(({ p, plan }) => (
              <tr class={p.slug === 'sogocloud' ? 'hl' : ''}><td><BrandName p={p} /></td><td>{plan.name}</td><td class="num price">{fmtPrice(plan.price)}</td><td class="num">{fmtPrice(monthlyEq(plan)!)}</td><td class="num">{fmtGB(plan.traffic)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" id="no-expiry">
      <h2>不限时流量包：一次买、不过期</h2>
      <p>一个月只用几次，或者想留一个备用机场，买不限时包最省。注意“不限时”是不限时间，不是不限流量。<a href="/knowledge/unlimited/">不限时机场是什么</a></p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">机场</th><th scope="col">流量包</th><th scope="col">价格</th><th scope="col">总流量</th><th scope="col">每 GB</th></tr></thead>
          <tbody>
            {oneTime.map(({ p, plan }) => (
              <tr class={p.slug === 'sogocloud' ? 'hl' : ''}><td><BrandName p={p} /></td><td>{plan.name}</td><td class="num price">{fmtPrice(plan.price)}</td><td class="num">{fmtGB(plan.traffic)}</td><td class="num">¥{perGB(plan)!.toFixed(2)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <h2>便宜机场、免费机场和低价小机场的区别</h2>
      <p>搜“便宜机场”会看到很多几块钱甚至免费的选择。价格看起来差不多，但线路、稳定性和流量算法差很多，下表帮你分清楚。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col"></th><th scope="col">本页便宜专线机场</th><th scope="col">低价小机场</th><th scope="col">免费节点</th></tr></thead>
          <tbody>
            <tr><td><strong>价格</strong></td><td>月付 ¥{lowest.plan.price} 起 / 年付 ¥{lowestYear.plan.price} 起</td><td>几块钱一个月</td><td>免费</td></tr>
            <tr><td><strong>线路</strong></td><td>IPLC / IEPL 专线</td><td>多为公网直连，常不写线路</td><td>公网，人多拥堵</td></tr>
            <tr><td><strong>晚高峰</strong></td><td>稳定</td><td>容易卡、掉线</td><td>经常连不上</td></tr>
            <tr><td><strong>流量倍率</strong></td><td>多数 1 倍</td><td>常见 2–3 倍</td><td>限速限量</td></tr>
            <tr><td><strong>适合</strong></td><td>长期日常使用</td><td>临时备用</td><td>不建议使用</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <h2>买便宜机场的 4 个提醒</h2>
      <p>买便宜机场最容易踩的坑，不是买贵了，而是“看着便宜、实际不划算”。下单前对照这 4 条检查一遍。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">提醒</th><th scope="col">为什么</th><th scope="col">怎么做</th></tr></thead>
          <tbody>
            <tr><td><strong>1. 看清“¥7 起”</strong></td><td>很多机场首页写的起步价是年付除以 12</td><td>比较时看真实月付价，或把年付价除以 12 再比</td></tr>
            <tr><td><strong>2. 看线路和倍率</strong></td><td>节点 2–3 倍扣流量，150GB 实际只能用 50–75GB</td><td>选写明线路、1 倍率的机场。<a href="/knowledge/traffic-multiplier/">流量倍率是什么</a></td></tr>
            <tr><td><strong>3. 先月付后年付</strong></td><td>低价机场停运的风险更高</td><td>先买一个月，晚高峰用稳了再长付。<a href="/knowledge/risk-guide/">机场跑路防范</a></td></tr>
            <tr><td><strong>4. 填优惠码</strong></td><td>不填就是原价</td><td>结算页填写本页表格里的优惠码</td></tr>
          </tbody>
        </table>
      </div>
      <p>想比较“同样的钱能买多少流量”，看 <a href="/value/">性价比机场</a>；想看综合排名，看 <a href="/recommend/">机场排行榜</a>。</p>
    </section>

    <section class="section">
      <h2>便宜机场常见问题</h2>
      <p>预算有限的新手最关心的几个问题，答案里的价格会随本站数据自动更新。</p>
      {faq.map((f) => <div class="qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
    </section>
  </div>
</BaseLayout>
