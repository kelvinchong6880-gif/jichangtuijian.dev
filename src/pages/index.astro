---
import BaseLayout from '../layouts/BaseLayout.astro';
import Disclosure from '../components/Disclosure.astro';
import Promo from '../components/Promo.astro';
import BrandName from '../components/BrandName.astro';
import {
  getProviders, getProviderBySlug, USAGE, cheapestFor, usagePrice, monthlyEq, perGB, fmtGB, fmtPrice, planPrice, planTraffic,
  unlockText, UPDATED, UPDATED_LABEL, UPDATED_MONTH, UPDATED_TAG, type Plan, type Provider,
} from '../data/providers';
import { faqSchema, itemListSchema } from '../data/schema';

const providers = getProviders();
const n = providers.length;
const sogo = getProviderBySlug('sogocloud')!;
const weifeng = getProviderBySlug('weifeng')!;
const wuyou = getProviderBySlug('wuyou')!;
const kuajie = getProviderBySlug('kuajieyun')!;
const cheapestEntry = [...providers].filter((p) => p.entry).sort((a, b) => a.entry!.price - b.entry!.price)[0];
const totalPlans = providers.reduce((s, p) => s + p.priced.length, 0);

const picks = [
  { p: sogo, tag: '综合首选', top: true, text: `${sogo.lineLabel} 双专线，${planPrice(sogo.entry!)} 就有 ${fmtGB(sogo.entry!.traffic)}，晚高峰稳、解锁 Netflix 和 ChatGPT，9 款套餐从轻度到全家都能选。` },
  { p: weifeng, tag: '流量首选', text: `同价位流量最多：${planPrice(weifeng.entry!)} ${fmtGB(weifeng.entry!.traffic)}，¥57/月 500GB，追剧、多设备更划算。` },
  { p: wuyou, tag: '预算首选', text: `月付最便宜：${planPrice(wuyou.entry!)} ${fmtGB(wuyou.entry!.traffic)}，年付 ${fmtPrice(wuyou.minYearly!.price)} 起，全 IPLC 专线。` },
];

const usageRows = USAGE.map((u) => {
  const options = providers
    .map((p) => ({ p, plan: cheapestFor(p, u.need) }))
    .filter((x) => x.plan)
    .sort((a, b) => monthlyEq(a.plan!)! - monthlyEq(b.plan!)!);
  return { u, cheapest: options[0], sogo: { p: sogo, plan: cheapestFor(sogo, u.need) } };
});

// 按人群推荐：全部从套餐数据里挑，价格变了自动换人
const allPlans = providers.flatMap((p) => p.priced.map((plan) => ({ p, plan })));
const byMonthly = (list: { p: Provider; plan: Plan }[]) => [...list].sort((a, b) => monthlyEq(a.plan)! - monthlyEq(b.plan)!)[0];
const byPerGB = (list: { p: Provider; plan: Plan }[]) => [...list].sort((a, b) => perGB(a.plan)! - perGB(b.plan)!)[0];
const student = byMonthly(allPlans.filter(({ plan }) => plan.billing === 'Yearly'));
const video = byMonthly(providers.filter((p) => p.streaming).map((p) => ({ p, plan: cheapestFor(p, 300)! })).filter((x) => x.plan));
const aiPick = byMonthly(providers.filter((p) => p.ai && p.entry).map((p) => ({ p, plan: p.entry! })));
const family = byPerGB(allPlans.filter(({ plan }) => plan.billing !== 'One-Time' && (plan.traffic ?? 0) >= 1000));
const occasional = allPlans.filter(({ plan }) => plan.billing === 'One-Time').sort((a, b) => a.plan.price - b.plan.price || b.plan.traffic! - a.plan.traffic!)[0];
const personas = [
  { who: '第一次买机场的新手', p: sogo, plan: sogo.entry!, why: `${sogo.lineLabel} 双专线，晚高峰稳；套餐从 60GB 到 1TB 都有，以后不用换机场。` },
  { who: '学生党 / 只查资料', ...student, why: `年付小包一次付清，折合每月约 ${fmtPrice(monthlyEq(student.plan)!)}，查资料、用 ChatGPT 够用。` },
  { who: '用 ChatGPT、Claude 等 AI', ...aiPick, why: '官网写明支持 AI 解锁的机场里月付最便宜的一档。' },
  { who: '追剧、看 Netflix / 4K', ...video, why: '支持流媒体解锁、每月 300GB 以上的套餐里折合月价最低。' },
  { who: '全家共用、经常下载', ...family, why: `每月 1TB 以上的套餐里每 GB 最便宜，约 ¥${perGB(family.plan)!.toFixed(3)}/GB。` },
  { who: '一个月只用几次', ...occasional, why: '不限时流量包里总价最低，一次付钱，流量用完为止、不会每月清零。' },
];

// 价格矩阵：每家在各用量档最便宜的周期套餐（折合月价）
const matrixNeeds = [50, 150, 300, 600, 1000];
const matrix = providers.map((p) => ({ p, cells: matrixNeeds.map((need) => cheapestFor(p, need)) }));
const matrixMin = matrixNeeds.map((_, i) => Math.min(...matrix.map((r) => (r.cells[i] ? monthlyEq(r.cells[i]!)! : Infinity))));
const unlockedCount = providers.filter((p) => p.streaming && p.ai).length;

const faq = [
  { q: '新手第一次买机场，推荐哪家？', a: `直接选 ${sogo.name} 基础版：¥25/月、每月 150GB，${sogo.lineLabel} 专线晚上也稳，能看 Netflix、用 ChatGPT。结算时填优惠码 ${sogo.promo}。先买一个月，用顺了再考虑年付。` },
  { q: '机场是什么意思？跟 VPN 是一回事吗？', a: '机场就是提供翻墙节点的订阅服务，买完给你一条订阅链接，导入 Clash、小火箭这类客户端就能用。和传统 VPN 比，机场更便宜、节点更多、按流量收费，所以国内大多数人用的是机场。' },
  { q: '买机场一个月要多少钱？', a: `主流价格是 ¥20–¥30 一个月，能用 100–200GB。本站收录的最低是 ${cheapestEntry.name} ${planPrice(cheapestEntry.entry!)}（${fmtGB(cheapestEntry.entry!.traffic)}）；只用来查资料的话，年付小包一年 ¥79–¥98 更省。` },
  { q: '一个月多少流量够我用？', a: '只查资料、用 ChatGPT 约 50GB；每天刷 1–2 小时视频约 150GB；常看 4K 约 300GB；全家一起用 600GB 以上。不确定就先买 150GB 的，下个月再调整。' },
  { q: '买了之后怎么用？难不难？', a: '不难，三步：在机场官网复制订阅链接 → 打开客户端粘贴导入 → 选一个香港或日本节点打开开关。本站有 Windows、Mac、iPhone、安卓的图文教程，跟着做 10 分钟左右就能用上。' },
  { q: '机场会不会跑路？钱会不会白花？', a: '任何机场都有停运的可能，所以新手最稳妥的做法是：先买月付，不要一次买两三年；选运营时间长、套餐写得清楚的机场。本站更多建议见“机场跑路防范”一文。' },
  { q: '便宜机场推荐哪家？', a: `只看月付价格，最便宜的是 ${cheapestEntry.name} ${planPrice(cheapestEntry.entry!)}（${fmtGB(cheapestEntry.entry!.traffic)}）；想要便宜又稳，选 ${sogo.name} 基础版 ${planPrice(sogo.entry!)}。学生党可以看年付小包，${student.p.name} ${planPrice(student.plan)} 起。完整列表见本站“便宜机场推荐”。` },
  { q: '性价比最高的机场是哪家？', a: `看你每月用多少。300GB 左右推荐 ${sogo.name} 优选版（¥45/月 350GB）；每月 1TB 以上，${family.p.name} ${family.plan.name} 每 GB 最便宜（${planPrice(family.plan)} ${fmtGB(family.plan.traffic)}）。各流量档的每 GB 排行见本站“性价比机场推荐”。` },
];

const schemas = [itemListSchema(`${UPDATED_MONTH}机场推荐`, providers), faqSchema(faq)];
---

<BaseLayout
  title={`机场推荐2026：${n}家好用机场排名与价格对比（${UPDATED_TAG}）`}
  description={`2026机场推荐（${UPDATED_MONTH}更新）：${n}家IPLC/IEPL专线机场排名，月付¥${cheapestEntry.entry!.price}起，对比价格、流量、线路和优惠码，按用量推荐套餐，附便宜机场、性价比机场排行和Windows/iPhone/安卓使用教程。`}
  structuredData={schemas}
>
  <div class="container page">
    <p class="eyebrow">更新于 <time datetime={UPDATED}>{UPDATED_LABEL}</time> · {n} 家机场 · {totalPlans} 个套餐</p>
    <h1>机场推荐 2026：{n} 家好用机场排名与价格对比</h1>
    <p class="lead">想找一个稳定、不贵、新手也会用的机场？我们把 {n} 家 IPLC / IEPL 专线机场的全部 {totalPlans} 个套餐放在一起比较：月付多少钱、每月多少流量、有没有不限时包、能不能看 Netflix 和用 ChatGPT。先看下面 3 个推荐，再按你的用量挑套餐。</p>
    <Disclosure />

    <section class="section" aria-labelledby="picks">
      <h2 id="picks">{UPDATED_MONTH}机场推荐：3 个最值得买的</h2>
      <p>不想看长表格，就从这 3 家里选：{sogo.name} 适合大多数人，{weifeng.name} 同价流量最多，{wuyou.name} 月付门槛最低。三家都是专线机场，第一次买建议先月付试用。</p>
      <div class="picks">
        {picks.map(({ p, tag, top, text }) => (
          <div class={`pick ${top ? 'top' : ''}`}>
            <span class={`pick-tag ${top ? '' : 'alt'}`}>{tag}</span>
            <BrandName p={p} />
            <div class="pick-price">{fmtPrice(p.entry!.price)}<small> /月起 · {fmtGB(p.entry!.traffic)}</small></div>
            <p>{text}</p>
            <div class="actions">
              <a class="btn" href={p.affiliateUrl} target="_blank" rel="nofollow sponsored noopener">前往官网</a>
              <a href={p.url}>看测评</a>
              <Promo code={p.promo} />
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="top">
      <h2 id="top">2026 机场推荐排行：{n} 家机场一表对比</h2>
      <p>排名综合了价格、专线质量、流量档位和套餐灵活性。点机场名看详细测评，<a href="/recommend/">完整机场排行榜</a>里有每家的推荐理由。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">排名</th><th scope="col">机场</th><th scope="col">月付起步</th><th scope="col">年付最低</th><th scope="col">每月流量</th><th scope="col">线路</th><th scope="col">不限时包</th><th scope="col">优惠码</th><th scope="col"><span class="sr-only">操作</span></th></tr></thead>
          <tbody>
            {providers.map((p, i) => (
              <tr class={i === 0 ? 'hl' : ''}>
                <td><span class={`rank ${i === 0 ? 'rank-1' : ''}`}>{i + 1}</span></td>
                <td><BrandName p={p} /></td>
                <td class="num"><span class="price">{p.entry ? fmtPrice(p.entry.price) : '—'}</span> / {p.entry ? fmtGB(p.entry.traffic) : ''}</td>
                <td class="num">{p.minYearly ? `${fmtPrice(p.minYearly.price)} / ${fmtGB(p.minYearly.traffic)}` : '—'}</td>
                <td class="num">{fmtGB(p.minTraffic)}–{fmtGB(p.maxTraffic)}</td>
                <td>{p.lineLabel}</td>
                <td>{p.oneTime.length ? `有（${fmtPrice(p.oneTime[0].price)} 起）` : '无'}</td>
                <td><code>{p.promo ?? '—'}</code></td>
                <td><a class="btn btn-sm" href={p.affiliateUrl} target="_blank" rel="nofollow sponsored noopener">官网</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted">“年付最低”为年付价格 / 每月流量。多数机场官网标注全节点 1 倍率；价格以官网结算页为准。</p>
    </section>

    <section class="section" aria-labelledby="specs">
      <h2 id="specs">{n} 家机场核心参数一览</h2>
      <p>价格之外，新手最常问的是：节点有哪些地区、能不能看 Netflix 和用 ChatGPT、能同时登几台设备。下表按各家官网信息整理，“官网未标注”表示官网没写，不代表一定不支持。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">机场</th><th scope="col">线路</th><th scope="col">节点地区</th><th scope="col">流媒体 / AI 解锁</th><th scope="col">设备数</th><th scope="col">套餐数</th><th scope="col">适合</th></tr></thead>
          <tbody>
            {providers.map((p, i) => (
              <tr class={i === 0 ? 'hl' : ''}>
                <td><BrandName p={p} /></td>
                <td>{p.lineLabel}</td>
                <td style="min-width:200px">{p.nodeRegions ?? '—'}</td>
                <td>{unlockText(p)}</td>
                <td>{p.deviceInfo ?? '—'}</td>
                <td class="num">{p.priced.length} 个</td>
                <td style="min-width:180px">{p.bestFor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted">{n} 家里有 {unlockedCount} 家官网同时写明支持流媒体和 ChatGPT 解锁。</p>
    </section>

    <section class="section" aria-labelledby="usage">
      <h2 id="usage">按用量选机场：每档最便宜的套餐</h2>
      <p>先估算自己每月用多少流量，再看对应那一档。年付套餐已折成每月价格。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">你的用量</th><th scope="col">每月需要</th><th scope="col">最便宜的选择</th><th scope="col">{sogo.name}（专线首选）</th></tr></thead>
          <tbody>
            {usageRows.map(({ u, cheapest, sogo: s }) => (
              <tr>
                <td><strong>{u.label}</strong><br /><span class="muted">{u.desc}</span></td>
                <td class="num">{u.need}GB+</td>
                <td>{cheapest ? <><a href={cheapest.p.url}>{cheapest.p.name}</a> {cheapest.plan!.name}<br /><span class="num price">{usagePrice(cheapest.plan!)}</span> · {fmtGB(cheapest.plan!.traffic)}/月</> : '—'}</td>
                <td>{s.plan ? <>{s.plan.name}<br /><span class="num price">{usagePrice(s.plan)}</span> · {fmtGB(s.plan.traffic)}/月</> : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>每月用量很少、一个月只用几次？买不限时流量包更省，比如 Firefly ¥100 买 100GB、无忧链接 ¥108 买 100GB，流量用完为止、不会过期。</p>
    </section>

    <section class="section" aria-labelledby="matrix">
      <h2 id="matrix">机场价格对照表：每家每档用量要花多少钱</h2>
      <p>同一个用量，不同机场的价格可能差一倍。下表列出每家满足该用量的最便宜套餐，年付、季付已折成每月价格，<strong>标色的是这一档最便宜的</strong>。“—”表示这家没有这么大的套餐。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">机场</th>{matrixNeeds.map((need) => <th scope="col">每月 {fmtGB(need)}+</th>)}</tr></thead>
          <tbody>
            {matrix.map(({ p, cells }) => (
              <tr>
                <td><BrandName p={p} /></td>
                {cells.map((c, i) => <td class="num">{c ? <><span class={monthlyEq(c)! === matrixMin[i] ? 'price' : ''}>{fmtPrice(monthlyEq(c)!)}/月</span><br /><span class="muted">{c.name} · {fmtGB(c.traffic)}</span></> : '—'}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" aria-labelledby="persona">
      <h2 id="persona">不同人群的机场推荐</h2>
      <p>不知道自己算哪种？对号入座就行。下表按当前价格自动挑选，价格变了会跟着换。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">你是</th><th scope="col">推荐机场</th><th scope="col">推荐套餐</th><th scope="col">为什么</th></tr></thead>
          <tbody>
            {personas.map(({ who, p, plan, why }) => (
              <tr>
                <td><strong>{who}</strong></td>
                <td><BrandName p={p} /></td>
                <td class="num">{plan.name}<br /><span class="price">{planPrice(plan)}</span> · {planTraffic(plan)}</td>
                <td style="min-width:220px">{why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" aria-labelledby="find">
      <h2 id="find">按需求找机场</h2>
      <p>首页只放最常用的信息。只在意价格、只在意每 GB 单价，或者在两家之间犹豫，可以直接看下面的专题页，每页都有完整表格。</p>
      <div class="grid">
        <a class="box" href="/recommend/"><strong>机场排行榜 →</strong><p class="muted" style="margin:.4rem 0 0">{n} 家机场综合排名，每家的推荐理由、优缺点和适合人群。</p></a>
        <a class="box" href="/cheap/"><strong>便宜机场推荐 →</strong><p class="muted" style="margin:.4rem 0 0">月付 ¥{cheapestEntry.entry!.price} 起、年付 ¥79 起的低价机场和不限时包。</p></a>
        <a class="box" href="/value/"><strong>性价比机场 →</strong><p class="muted" style="margin:.4rem 0 0">把每个套餐换算成每 GB 价格，按流量档排行。</p></a>
        <a class="box" href="/compare/"><strong>机场对比 →</strong><p class="muted" style="margin:.4rem 0 0">{sogo.name} vs 微风、飞猫云 vs 微风等热门机场两两对比。</p></a>
      </div>
    </section>

    <section class="section" aria-labelledby="newbie">
      <h2 id="newbie">新手第一次用机场：3 步搞定</h2>
      <p>从下单到能用，一般 10 分钟左右。整个过程不需要懂技术，照着下表做就行。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">步骤</th><th scope="col">做什么</th><th scope="col">注意</th><th scope="col">参考</th></tr></thead>
          <tbody>
            <tr><td><strong>1. 选机场、买月付</strong></td><td>从上面的推荐里挑一家，注册后买一个月</td><td>结算页填优惠码；第一次不要买年付</td><td><a href="/knowledge/what-is-jichang/">机场是什么</a></td></tr>
            <tr><td><strong>2. 复制订阅链接</strong></td><td>在机场官网用户中心复制订阅链接</td><td>这串链接等于你的账号，不要发给别人</td><td><a href="/knowledge/subscription/">订阅链接怎么用</a></td></tr>
            <tr><td><strong>3. 导入客户端</strong></td><td>打开客户端粘贴订阅，选香港或日本节点，打开开关</td><td>连不上先换节点，再检查系统时间</td><td><a href="/tutorial/">使用教程</a></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" aria-labelledby="clients">
      <h2 id="clients">各设备用什么客户端</h2>
      <p>机场只提供节点，要在手机或电脑上装一个客户端才能用。下面是各平台常用的客户端，具体以机场后台推荐的为准，下载时认准官方渠道。</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">设备</th><th scope="col">常用客户端</th><th scope="col">去哪下载</th><th scope="col">教程</th></tr></thead>
          <tbody>
            <tr><td><strong>Windows</strong></td><td>Clash Verge Rev、v2rayN</td><td>GitHub Release 或机场后台</td><td><a href="/tutorial/windows/">Windows 教程</a></td></tr>
            <tr><td><strong>Mac</strong></td><td>Clash Verge Rev</td><td>GitHub Release 或机场后台</td><td><a href="/tutorial/mac/">Mac 教程</a></td></tr>
            <tr><td><strong>iPhone / iPad</strong></td><td>Shadowrocket（小火箭）、Stash</td><td>非国区 App Store</td><td><a href="/tutorial/ios/">iPhone 教程</a></td></tr>
            <tr><td><strong>安卓</strong></td><td>Clash Meta for Android、v2rayNG</td><td>GitHub Release 或机场后台</td><td><a href="/tutorial/android/">安卓教程</a></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" aria-labelledby="how">
      <h2 id="how">挑机场看这 5 点</h2>
      <p>机场的宣传都差不多，真正拉开差距的是下面 5 项。自己挑机场时，逐项对照就不容易踩坑。</p>
      <div class="tbl-wrap">
        <table class="tbl">
