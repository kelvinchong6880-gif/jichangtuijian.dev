---
import BaseLayout from '../layouts/BaseLayout.astro';
import Disclosure from '../components/Disclosure.astro';
import ProviderCard from '../components/ProviderCard.astro';
import BrandName from '../components/BrandName.astro';
import { getProviders, perGB, fmtGB, fmtPrice, planPrice, UPDATED, UPDATED_LABEL, UPDATED_MONTH } from '../data/providers';
import { faqSchema, itemListSchema, articleSchema } from '../data/schema';

const providers = getProviders();
const n = providers.length;
const sogo = providers[0];

const subs = [
  {
    title: '月付最便宜',
    rows: [...providers].filter((p) => p.entry).sort((a, b) => a.entry!.price - b.entry!.price || b.entry!.traffic! - a.entry!.traffic!).slice(0, 5),
    val: (p: (typeof providers)[number]) => `${planPrice(p.entry!)} · ${fmtGB(p.entry!.traffic)}`,
    link: { href: '/cheap/', text: '便宜机场推荐' },
  },
  {
    title: '每 GB 最便宜',
    rows: [...providers].filter((p) => p.bestValue).sort((a, b) => perGB(a.bestValue!)! - perGB(b.bestValue!)!).slice(0, 5),
    val: (p: (typeof providers)[number]) => `¥${perGB(p.bestValue!)!.toFixed(3)}/GB（${p.bestValue!.name}）`,
    link: { href: '/value/', text: '性价比机场排行' },
  },
  {
    title: '大流量',
    rows: [...providers].sort((a, b) => b.maxTraffic - a.maxTraffic).slice(0, 5),
    val: (p: (typeof providers)[number]) => `最高 ${fmtGB(p.maxTraffic)}/月`,
    link: { href: '/value/#huge', text: '1TB 以上套餐' },
  },
  {
    title: '不限时流量包',
    rows: [...providers].filter((p) => p.oneTime.length).sort((a, b) => a.oneTime[0].price - b.oneTime[0].price).slice(0, 5),
    val: (p: (typeof providers)[number]) => `${fmtPrice(p.oneTime[0].price)} / ${fmtGB(p.oneTime[0].traffic)}`,
    link: { href: '/cheap/#no-expiry', text: '不限时包排行' },
  },
];

const title = `机场排行榜2026：${n}家机场综合排名与推荐理由（10月更新）`;
const description = `2026机场排行榜（${UPDATED_MONTH}更新）：${n}家IPLC/IEPL专线机场综合排名，逐家给出推荐理由、价格、流量、解锁和适合人群，附月付最便宜、每GB最便宜、大流量、不限时包4个分榜。`;

const faq = [
  { q: '机场排行榜第一名是哪家？', a: `${UPDATED_MONTH}排第一的是 ${sogo.name}：${sogo.verdict}。基础版 ${planPrice(sogo.entry!)} ${fmtGB(sogo.entry!.traffic)}，优惠码 ${sogo.promo}。` },
  { q: '这个机场排行榜怎么排的？', a: '综合 4 项：线路质量（IPLC/IEPL 专线优先）、价格与每 GB 成本、流量档位是否覆盖轻度到重度、套餐灵活性（年付小包、季付、不限时包）。每月按官网价格重新核对。' },
  { q: '排名靠后的机场就不好吗？', a: '不是。分榜里很多“单项第一”都不是综合第一，比如跨界云每 GB 最便宜、无忧链接月付最便宜。按自己最在意的一项看分榜更准。' },
  { q: '机场排名多久更新一次？', a: `每月更新。本页数据核对于 ${UPDATED_LABEL}，价格变化会同步到首页、便宜机场、性价比机场和对比页。` },
];

const schemas = [itemListSchema(`${UPDATED_MONTH}机场排行榜`, providers), faqSchema(faq), articleSchema(title, description, '/recommend/')];
---

<BaseLayout title={title} description={description} structuredData={schemas} ogType="article" breadcrumbs={[{ name: '机场排行榜', path: '/recommend/' }]}>
  <div class="container page">
    <p class="eyebrow">更新于 <time datetime={UPDATED}>{UPDATED_LABEL}</time></p>
    <h1>机场排行榜 2026：{n} 家机场综合排名</h1>
    <p class="lead">这份机场排行榜按线路、价格、流量档位和套餐灵活性给 {n} 家专线机场排名。每家都写了推荐理由和适合人群；只在意一项的话，直接看下面的 4 个分榜。</p>
    <Disclosure />

    <section class="section" aria-labelledby="rank">
      <h2 id="rank">{UPDATED_MONTH}机场综合排名</h2>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">排名</th><th scope="col">机场</th><th scope="col">推荐理由</th><th scope="col">月付起步</th><th scope="col">适合</th></tr></thead>
          <tbody>
            {providers.map((p, i) => (
              <tr class={i === 0 ? 'hl' : ''}>
                <td><span class={`rank ${i === 0 ? 'rank-1' : ''}`}>{i + 1}</span></td>
                <td><BrandName p={p} /></td>
                <td style="min-width:260px">{p.verdict}</td>
                <td class="num">{p.entry ? `${fmtPrice(p.entry.price)} / ${fmtGB(p.entry.traffic)}` : '—'}</td>
                <td style="min-width:180px">{p.bestFor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" aria-labelledby="subs">
      <h2 id="subs">机场分榜：按单项排名</h2>
      <div class="grid">
        {subs.map((s) => (
          <div class="box">
            <h3>{s.title}</h3>
            <ol class="list">
              {s.rows.map((p) => <li><a href={p.url}>{p.name}</a>：<span class="num">{s.val(p)}</span></li>)}
            </ol>
            <a href={s.link.href}>{s.link.text} →</a>
          </div>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="detail">
      <h2 id="detail">排行榜详解：{n} 家机场逐一点评</h2>
      {providers.map((p, i) => <ProviderCard provider={p} rank={i + 1} />)}
    </section>

    <section class="section" aria-labelledby="method">
      <h2 id="method">排名方法</h2>
      <ul class="list">
        <li><strong>线路质量</strong>：IPLC / IEPL 专线不经过拥堵的公网国际出口，晚高峰更稳。双专线（IPLC + IEPL）优先。</li>
        <li><strong>价格与单价</strong>：比较真实月付价，年付折算成每月，再换算每 GB 价格。</li>
        <li><strong>流量覆盖</strong>：从 50GB 轻度到 1TB 以上重度都有档位的机场加分。</li>
        <li><strong>套餐灵活性</strong>：有年付小包、季付、不限时流量包的机场加分。</li>
      </ul>
      <p>价格和套餐每月对照官网核对一次。线路知识可以看 <a href="/knowledge/iplc-iepl/">IPLC 与 IEPL 专线</a> 和 <a href="/knowledge/direct-relay-dedicated/">直连、中转与专线</a>。</p>
    </section>

    <section class="section" aria-labelledby="faq">
      <h2 id="faq">机场排行榜常见问题</h2>
      {faq.map((f) => <div class="qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
      <p style="margin-top:1rem">继续看：<a href="/">机场推荐</a> · <a href="/cheap/">便宜机场</a> · <a href="/value/">性价比机场</a> · <a href="/compare/">机场对比</a></p>
    </section>
  </div>
</BaseLayout>
