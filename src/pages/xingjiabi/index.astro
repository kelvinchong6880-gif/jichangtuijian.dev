---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBrands } from '../../utils/data';

const brands = await getBrands();
---

<BaseLayout title="性价比机场：价格、流量与倍率怎么比较" description="比较机场套餐时核对付款周期、流量重置和节点倍率。原始资料未统一到具体套餐前，本站不生成误导性的每 GB 排名。">
  <div class="max-w-4xl mx-auto space-y-8">
    <header class="border-b border-gray-200 pb-5">
      <h1 class="text-3xl font-extrabold text-gray-900">性价比机场怎么比较</h1>
      <p class="mt-3 text-lg text-gray-600">每 GB 成本必须把同一套餐的实付金额、流量周期和节点倍率放在一起计算。当前品牌摘要未逐项绑定所有套餐，暂不生成可能混用不同套餐的性价比排名。</p>
    </header>

    <section class="bg-white border border-gray-200 rounded-lg p-6">
      <h2 class="text-xl font-bold mb-3">计算方法</h2>
      <p class="text-gray-700">月付套餐：每 GB 成本＝月付金额 ÷ 当月可用 GB。年付但流量每月重置的套餐：先展示实际年付金额，再用年付金额 ÷ 12 ÷ 每月 GB 计算折算值。一次性流量套餐不能按月重置额度比较；高倍率节点的实际消耗也应单独说明。</p>
    </section>

    <section>
      <h2 class="text-xl font-bold mb-4">品牌原始价格记录</h2>
      <p class="text-sm text-gray-600 mb-4">下列月付、年付和流量数字可能来自不同套餐，不能直接相除。点击品牌查看原始套餐文字。</p>
      <ul class="grid sm:grid-cols-2 gap-3">
        {brands.map(brand => <li class="bg-white border border-gray-200 rounded-lg p-4"><a class="font-semibold text-blue-700 hover:underline" href={`/brands/${brand.id}/`}>{brand.data.name}</a><p class="text-sm text-gray-600 mt-2">月付记录：{brand.data.price_monthly ? `${brand.data.currency} ${brand.data.price_monthly}` : '资料未提供'}；年付记录：{brand.data.price_yearly ? `${brand.data.currency} ${brand.data.price_yearly}` : '资料未提供'}</p><p class="text-xs text-gray-500 mt-1">{brand.data.evidence_status} · 核验：{brand.data.verification_date}</p></li>)}
      </ul>
    </section>
  </div>
</BaseLayout>
