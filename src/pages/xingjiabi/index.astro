---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBrands } from '../../utils/data';

const allBrands = await getBrands();

const calculateValue = (brand: any) => {
  let monthlyPrice = brand.data.price_monthly;
  if (!monthlyPrice && brand.data.price_yearly) {
    monthlyPrice = brand.data.price_yearly / 12;
  }
  if (!monthlyPrice || monthlyPrice === 0) return 0;
  
  let gb = brand.data.bandwidth_gb;
  if (brand.data.bandwidth_reset_period === 'none') return -1; 
  
  return gb / monthlyPrice;
};

const sortedBrands = allBrands
  .map(b => ({ ...b, valueScore: calculateValue(b) }))
  .sort((a, b) => b.valueScore - a.valueScore);
---

<BaseLayout title="性价比机场推荐：高流量与低价格的平衡" description="寻找性价比最高的机场节点？我们通过计算每单位成本获得的流量额度，并结合倍率规则，为您推荐最有价值的选择。">
  
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="border-b border-gray-200 pb-5">
      <h1 class="text-3xl font-extrabold text-gray-900">性价比机场分析</h1>
      <p class="mt-3 text-xl text-gray-500">
        这里的排序基于“每消费1元所能获得的周期内流量（GB）”。注意，高性价比往往意味着线路为普通中转，晚高峰可能存在波动。
      </p>
    </div>

    <div class="bg-white shadow overflow-hidden sm:rounded-md">
      <ul role="list" class="divide-y divide-gray-200">
        {sortedBrands.map(brand => (
          <li>
            <div class="px-4 py-4 sm:px-6 hover:bg-gray-50">
              <div class="flex items-center justify-between">
                <p class="text-lg font-medium text-blue-600 truncate">
                  <a href={`/brands/${brand.id}/`}>{brand.data.name}</a>
                  {brand.id === 'sogo' && <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">本站主推</span>}
                </p>
                <div class="ml-2 flex-shrink-0 flex">
                  <p class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    {brand.valueScore > 0 ? `${brand.valueScore.toFixed(1)} GB/元` : (brand.valueScore === -1 ? '不限时无法计算' : '资料不全')}
                  </p>
                </div>
              </div>
              <div class="mt-2 sm:flex sm:justify-between">
                <div class="sm:flex">
                  <p class="flex items-center text-sm text-gray-500">
                    基础套餐：{brand.data.currency} {brand.data.price_monthly || (brand.data.price_yearly ? brand.data.price_yearly + '/年' : '-')} 
                  </p>
                  <p class="mt-2 flex items-center text-sm text-gray-500 sm:mt-0 sm:ml-6">
                    流量：{brand.data.bandwidth_gb}GB ({brand.data.bandwidth_reset_period === 'monthly' ? '月置' : brand.data.bandwidth_reset_period})
                  </p>
                </div>
                <div class="mt-2 flex items-center text-sm text-gray-500 sm:mt-0">
                  <p>
                    状态: {brand.data.evidence_status}
                  </p>
                </div>
              </div>
              {brand.data.multiplier_desc && (
                <div class="mt-2 text-xs text-orange-600">
                  注意：{brand.data.multiplier_desc}（高倍率节点会加速消耗流量，降低实际性价比）
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
    
  </div>

</BaseLayout>
