---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="友情链接与相关网站 | 机场推荐"
  description="这里整理了一些与网络工具、机场知识和相关内容有关的网站，方便读者进一步浏览。"
>
  <div class="container">
    <div style="margin-bottom: 2rem;">
      <h1>友情链接与相关网站</h1>
      <p style="color: var(--text-muted); line-height: 1.6;">
        这里整理了一些与网络工具、机场知识和相关内容有关的网站，方便读者进一步浏览。链接收录不代表本站对第三方网站内容、服务或安全性作出保证。
      </p>
    </div>

    <div class="article-content" style="background: var(--card-bg); padding: 2rem; border-radius: 8px; border: 1px solid var(--border-color);">
      <ul style="list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">

        <li style="padding: 1rem; border: 1px solid var(--border-color); border-radius: 8px;">
          <a href="https://clashwiki.blog/" target="_blank" rel="nofollow noopener" style="font-weight: bold; font-size: 1.1rem; display: block; margin-bottom: 0.5rem;">
            Clash Wiki
          </a>
          <p style="margin: 0; color: var(--text-muted); font-size: 0.9rem;">Clash 客户端下载、配置与使用教程。</p>
        </li>

        <li style="padding: 1rem; border: 1px solid var(--border-color); border-radius: 8px;">
          <a href="https://jichangblog.net/" target="_blank" rel="nofollow noopener" style="font-weight: bold; font-size: 1.1rem; display: block; margin-bottom: 0.5rem;">
            机场博客
          </a>
          <p style="margin: 0; color: var(--text-muted); font-size: 0.9rem;">机场测评、套餐对比与选购经验。</p>
        </li>

        <li style="padding: 1rem; border: 1px solid var(--border-color); border-radius: 8px;">
          <a href="https://vpn-clash.net/" target="_blank" rel="nofollow noopener" style="font-weight: bold; font-size: 1.1rem; display: block; margin-bottom: 0.5rem;">
            VPN Clash
          </a>
          <p style="margin: 0; color: var(--text-muted); font-size: 0.9rem;">VPN 与 Clash 相关的资源与使用指南。</p>
        </li>

        <li style="padding: 1rem; border: 1px solid var(--border-color); border-radius: 8px;">
          <a href="https://jichangmao.com/" target="_blank" rel="nofollow noopener" style="font-weight: bold; font-size: 1.1rem; display: block; margin-bottom: 0.5rem;">
            机场猫
          </a>
          <p style="margin: 0; color: var(--text-muted); font-size: 0.9rem;">机场推荐与优惠信息整理。</p>
        </li>

        <li style="padding: 1rem; border: 1px solid var(--border-color); border-radius: 8px;">
          <a href="https://bestjichang.com/" target="_blank" rel="nofollow noopener" style="font-weight: bold; font-size: 1.1rem; display: block; margin-bottom: 0.5rem;">
            Best 机场
          </a>
          <p style="margin: 0; color: var(--text-muted); font-size: 0.9rem;">好用机场推荐与排行。</p>
        </li>


      </ul>
    </div>
  </div>
</BaseLayout>
